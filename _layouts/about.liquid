---
layout: default
---
{% comment %}
  HOME PAGE LAYOUT (local override of the al-folio "about" layout).
  The text shown here comes from _pages/about.md (front matter + body),
  the numbers at a glance and the selected papers from _bibliography/papers.bib,
  the research cards from _projects/*.md, the collaboration map from
  _data/collaborations.yml, the fellowships & awards from _data/cv.yml, the news
  from _news/*.md and the contact buttons from _data/socials.yml.
  Styling: _sass/_design.scss.
{% endcomment %}

{% assign socials = site.data.socials %}
{% assign section_no = 0 -%}
{% comment %} numbers the sections below 01, 02, … {% endcomment %}
{% assign profile = page.profile %}

{% comment %} Photo path: accepts "prof_pic.jpg" or "/assets/img/prof_pic.jpg" {% endcomment %}
{% assign photo = profile.image | default: 'prof_pic.jpg' %}
{% unless photo contains '/' %}
  {% assign photo = photo | prepend: 'assets/img/' %}
{% endunless %}
{% assign photo_first_char = photo | slice: 0 %}
{% if photo_first_char == '/' %}
  {% assign photo = photo | remove_first: '/' %}
{% endif %}

{% comment %} Contact buttons, reused in the hero and the contact band {% endcomment %}
{% capture profile_links %}
  {% if socials.scholar_userid %}
    <a class="btn-site" href="https://scholar.google.com/citations?user={{ socials.scholar_userid }}"><i class="ai ai-google-scholar"></i> Google Scholar</a>
  {% endif %}
  {% if socials.orcid_id %}
    <a class="btn-site" href="https://orcid.org/{{ socials.orcid_id }}"><i class="ai ai-orcid"></i> ORCID</a>
  {% endif %}
  {% if socials.research_gate_profile %}
    <a class="btn-site" href="https://www.researchgate.net/profile/{{ socials.research_gate_profile }}/"><i class="ai ai-researchgate"></i> ResearchGate</a>
  {% endif %}
  {% if socials.linkedin_username %}
    <a class="btn-site" href="https://www.linkedin.com/in/{{ socials.linkedin_username }}"><i class="fa-brands fa-linkedin"></i> LinkedIn</a>
  {% endif %}
  {% if socials.github_username %}
    <a class="btn-site" href="https://github.com/{{ socials.github_username }}"><i class="fa-brands fa-github"></i> GitHub</a>
  {% endif %}
{% endcapture %}

<div class="home">
  <!-- Introduction -->
  <section class="home-hero">
    <div class="home-intro">
      {% if page.eyebrow %}
        <p class="home-eyebrow">{{ page.eyebrow }}</p>
      {% endif %}
      <h1 class="home-name">
        {% if site.title == 'blank' %}
          {{- site.first_name }}
          {% if site.middle_name %}{{ site.middle_name }} {% endif %}
          {{- site.last_name -}}
        {% else %}
          {{- site.title -}}
        {% endif %}
      </h1>
      {% if page.subtitle %}
        <p class="home-role">{{ page.subtitle }}</p>
      {% endif %}

      {% if profile.department or profile.institution or profile.location %}
        <p class="home-affiliation">
          {% if profile.department -%}
            <span>{{ profile.department }}</span>
          {%- endif %}
          {% if profile.institution -%}
            <strong>{{ profile.institution }}</strong>
          {%- endif %}
          {% if profile.location -%}
            <span>{{ profile.location }}</span>
          {%- endif %}
        </p>
      {% endif %}

      <div class="home-bio">{{ content }}</div>

      <div class="home-actions">
        {% if socials.email %}
          <a class="btn-site btn-site--primary" href="mailto:{{ socials.email }}"><i class="fa-solid fa-envelope"></i> Email me</a>
        {% endif %}
        {{ profile_links }}
        <a class="btn-site" href="{{ '/cv/' | relative_url }}"><i class="fa-solid fa-file-lines"></i> CV</a>
      </div>
    </div>

    <div class="home-portrait">
      {%
        include figure.liquid
        loading="eager"
        path=photo
        sizes="(min-width: 768px) 360px, 62vw"
        alt=page.profile.image_alt
        cache_bust=true
      %}
    </div>
  </section>

  {% comment %}
    Numbers at a glance, counted automatically from _bibliography/papers.bib.
    First-author papers: entries whose author list starts with my name as Google
    Scholar writes it ("Ge, Liangfu", "Ge, L"; from scholar.last_name/first_name in
    _config.yml). Citations and h-index come from _data/citations.yml (updated every
    week by the "Update citation counts" workflow) and appear once it has data.
    Switch: `highlights` in _pages/about.md (panel: Home page).
  {% endcomment %}
  {% if page.highlights != false %}
    {% assign owner_last = site.scholar.last_name | first %}
    {% assign owner_initial = site.scholar.first_name | first | slice: 0 %}
    {% capture count_all %}{% bibliography_count %}{% endcapture %}
    {% capture count_journal %}{% bibliography_count --query @article %}{% endcapture %}
    {% capture count_conference %}{% bibliography_count --query @inproceedings, @conference, @proceedings %}{% endcapture %}
    {% capture count_first %}{% bibliography_count --query @*[author~=^{{ owner_last }}\W+{{ owner_initial }}] %}{% endcapture %}
    {% assign count_all = count_all | strip | plus: 0 %}
    {% assign cite_meta = site.data.citations.metadata %}
    {% assign cite_total = site.data.citations.totals.citations | default: 0 %}
    {% if count_all > 0 %}
      <section class="home-stats" aria-label="At a glance">
        <div class="home-stats__grid{% if cite_total > 0 %} home-stats__grid--6{% endif %}">
          <div class="home-stat">
            <span class="home-stat__num">{{ count_all }}</span>
            <span class="home-stat__label">Publications</span>
          </div>
          <div class="home-stat">
            <span class="home-stat__num">{{ count_journal | strip }}</span>
            <span class="home-stat__label">Journal papers</span>
          </div>
          <div class="home-stat">
            <span class="home-stat__num">{{ count_conference | strip }}</span>
            <span class="home-stat__label">Conference papers</span>
          </div>
          <div class="home-stat">
            <span class="home-stat__num">{{ count_first | strip }}</span>
            <span class="home-stat__label">As first author</span>
          </div>
          {% if cite_total > 0 %}
            <div class="home-stat">
              <span class="home-stat__num">
                {%- if cite_total >= 1000 -%}
                  {{- cite_total | divided_by: 1000 }},{{ cite_total | modulo: 1000 | prepend: '00' | slice: -3, 3 -}}
                {%- else -%}
                  {{- cite_total -}}
                {%- endif -%}
              </span>
              <span class="home-stat__label">Citations</span>
            </div>
            <div class="home-stat">
              <span class="home-stat__num">{{ site.data.citations.totals.h_index }}</span>
              <span class="home-stat__label">h-index</span>
            </div>
          {% endif %}
        </div>
        {% if cite_total > 0 %}
          <p class="home-stats__note">
            Citations and h-index:
            <a href="{{ cite_meta.source_url }}" target="_blank" rel="noopener noreferrer">{{ cite_meta.source }}</a>, updated
            {{ cite_meta.last_updated | date: '%-d %b %Y' }}.
          </p>
        {% endif %}
      </section>
    {% endif %}
  {% endif %}

  <!-- Research themes (one card per file in _projects/) -->
  {% assign themes = site.projects | sort: 'importance' %}
  {% if themes.size > 0 %}
    <section class="home-section" id="research">
      <div class="section-head">
        {% assign section_no = section_no | plus: 1 -%}
        <span class="section-index">
          {%- if section_no < 10 %}0{% endif -%}
          {{- section_no -}}
        </span>
        <h2>{{ page.research_heading | default: 'Research' }}</h2>
        <a class="section-link" href="{{ '/projects/' | relative_url }}">All research</a>
      </div>
      {% include theme_cards.liquid %}
    </section>
  {% endif %}

  {% comment %}
    Selected publications: the papers listed in `selected_publications` in
    _pages/about.md (editing panel → Home page → Selected publications), as BibTeX
    keys, shown in that order. If that list is empty, papers marked selected={true}
    in papers.bib are shown instead. A key not found in papers.bib is skipped, and the
    section is hidden when there is nothing to show.
  {% endcomment %}
  {% if page.selected_papers %}
    {% capture selected_html %}
      {% if page.selected_publications and page.selected_publications.size > 0 %}
        {% capture nocite_output %}
          {% for paper_key in page.selected_publications %}
            {% nocite paper_key %}
          {% endfor %}
        {% endcapture %}
        <div class="publications">
          {% bibliography --group_by none --cited_in_order %}
        </div>
      {% else %}
        {% include selected_papers.liquid %}
      {% endif %}
    {% endcapture %}
    {% if selected_html contains '<li' %}
      <section class="home-section" id="selected-publications">
        <div class="section-head">
          {% assign section_no = section_no | plus: 1 -%}
          <span class="section-index">
            {%- if section_no < 10 %}0{% endif -%}
            {{- section_no -}}
          </span>
          <h2>Selected publications</h2>
          <a class="section-link" href="{{ '/publications/' | relative_url }}">All publications</a>
        </div>
        {% include author_legend.liquid %}
        {{ selected_html }}
      </section>
    {% endif %}
  {% endif %}

  {% comment %}
    Collaboration network: world map with my institution and each collaboration
    (_includes/collaboration_map.liquid, content in _data/collaborations.yml; panel:
    Collaborations). Switch: `collaboration_map` in _pages/about.md (panel: Home page).
  {% endcomment %}
  {% if page.collaboration_map != false and site.data.collaborations.collaborations.size > 0 %}
    <section class="home-section" id="collaborations">
      <div class="section-head">
        {% assign section_no = section_no | plus: 1 -%}
        <span class="section-index">
          {%- if section_no < 10 %}0{% endif -%}
          {{- section_no -}}
        </span>
        <h2>Collaboration network</h2>
      </div>
      {% include collaboration_map.liquid %}
    </section>
  {% endif %}

  {% comment %}
    Fellowships & awards, read from the CV (_data/cv.yml, sections
    grants_and_fellowships and awards_and_honours), so they always match the CV.
    Each item's text before the first ", " is shown in bold, the rest below it.
    Switch: `recognition` in _pages/about.md (panel: Home page).
  {% endcomment %}
  {% assign cv_grants = site.data.cv.cv.sections.grants_and_fellowships %}
  {% assign cv_awards = site.data.cv.cv.sections.awards_and_honours %}
  {% assign recognition_total = cv_grants.size | default: 0 | plus: cv_awards.size %}
  {% if page.recognition != false and recognition_total > 0 %}
    <section class="home-section" id="recognition">
      <div class="section-head">
        {% assign section_no = section_no | plus: 1 -%}
        <span class="section-index">
          {%- if section_no < 10 %}0{% endif -%}
          {{- section_no -}}
        </span>
        <h2>Fellowships &amp; awards</h2>
        <a class="section-link" href="{{ '/cv/' | relative_url }}">Full CV</a>
      </div>
      <div class="recognition-grid">
        {% for group in (1..2) %}
          {% if group == 1 %}
            {% assign items = cv_grants %}
            {% assign group_title = 'Fellowships & funding' %}
          {% else %}
            {% assign items = cv_awards %}
            {% assign group_title = 'Awards & honours' %}
          {% endif %}
          {% if items.size > 0 %}
            <div class="recognition-group">
              <h3 class="recognition-group__title">{{ group_title | escape }}</h3>
              <ul class="recognition-list">
                {% for item in items %}
                  {% assign item_text = item.details | default: item.bullet | default: item %}
                  {% assign item_main = item_text | split: ', ' | first %}
                  {% assign item_rest = item_text | remove_first: item_main | remove_first: ', ' %}
                  <li>
                    {% if item.label -%}
                      <span class="recognition-list__year">{{ item.label }}</span>
                    {%- endif %}
                    <div>
                      <strong>{{ item_main }}</strong>
                      {% if item_rest != '' -%}
                        <span>{{ item_rest }}</span>
                      {%- endif %}
                    </div>
                  </li>
                {% endfor %}
              </ul>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </section>
  {% endif %}

  <!-- News (files in _news/) -->
  {% if page.announcements and page.announcements.enabled and site.news.size > 0 %}
    <section class="home-section" id="news">
      <div class="section-head">
        {% assign section_no = section_no | plus: 1 -%}
        <span class="section-index">
          {%- if section_no < 10 %}0{% endif -%}
          {{- section_no -}}
        </span>
        <h2>News</h2>
        <a class="section-link" href="{{ '/news/' | relative_url }}">All news</a>
      </div>
      {% assign news = site.news | sort: 'date' | reverse %}
      <ul class="news-list">
        {% for item in news limit: page.announcements.limit %}
          <li>
            <time datetime="{{ item.date | date_to_xmlschema }}">{{ item.date | date: '%b %d, %Y' }}</time>
            <div class="news-text">
              {% if item.inline %}
                {{ item.content | emojify }}
              {% else %}
                <p>
                  <a href="{{ item.url | relative_url }}">{{ item.title }}</a>
                </p>
              {% endif %}
              {% comment %} Labels for the item's media; the full item is on the News page {% endcomment %}
              {% assign item_anchor = '/news/#news-' | append: item.slug | relative_url %}
              {% if item.video_link or item.video_file or item.linkedin_post or item.images.size > 1 %}
                <p class="news-chips">
                  {% if item.images.size > 1 %}
                    <a href="{{ item_anchor }}"><i class="fa-regular fa-images"></i> {{ item.images.size }} photos</a>
                  {% endif %}
                  {% if item.video_link or item.video_file %}
                    <a href="{{ item_anchor }}"><i class="fa-solid fa-circle-play"></i> Video</a>
                  {% endif %}
                  {% if item.linkedin_post %}
                    <a href="{{ item_anchor }}"><i class="fa-brands fa-linkedin"></i> LinkedIn post</a>
                  {% endif %}
                </p>
              {% endif %}
            </div>
            {% if item.images.size > 0 %}
              {% assign thumb = item.images.first %}
              <a class="news-thumb" href="{{ item_anchor }}" aria-hidden="true" tabindex="-1">
                <img src="{{ thumb.src | default: thumb | relative_url }}" alt="" loading="lazy">
              </a>
            {% endif %}
          </li>
        {% endfor %}
      </ul>
    </section>
  {% endif %}

  <!-- Contact -->
  {% if page.social %}
    <section class="contact-band" id="contact">
      <div>
        <p class="home-eyebrow">Contact</p>
        <h2>{{ page.contact_heading | default: 'Get in touch' }}</h2>
        <p>{{ page.contact_note | default: site.contact_note }}</p>
      </div>
      <div class="home-actions">
        {% if socials.email %}
          <a class="btn-site btn-site--primary" href="mailto:{{ socials.email }}"><i class="fa-solid fa-envelope"></i> {{ socials.email }}</a>
        {% endif %}
        {{ profile_links }}
      </div>
    </section>
  {% endif %}

  <!-- Visitor counter (hidden until GoatCounter answers; _includes/visitor_counter.liquid) -->
  {% include visitor_counter.liquid %}
</div>
